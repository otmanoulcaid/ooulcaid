Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  # The bare minimum asked by the subject, for both machines.
  config.vm.provider "virtualbox" do |v|
    v.cpus = 1
    v.memory = 1024
  end

  # The server: K3s in controller mode.
  config.vm.define "ooulcaidS" do |server|
    server.vm.hostname = "ooulcaidS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provider "virtualbox" do |v|
      v.name = "ooulcaidS"
    end
    server.vm.provision "shell", path: "scripts/server.sh"
  end

  # The worker: K3s in agent mode.
  config.vm.define "ooulcaidSW" do |worker|
    worker.vm.hostname = "ooulcaidSW"
    worker.vm.network "private_network", ip: "192.168.56.111"
    worker.vm.provider "virtualbox" do |v|
      v.name = "ooulcaidSW"
    end
    worker.vm.provision "shell", path: "scripts/worker.sh"
  end
end
